---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { GuildShellData } from '../types';
import '../styles/global.css';

interface Props extends GuildShellData {}

const {
  title,
  description,
  path,
  canonical,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  site,
  services,
  areas,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  data-dg-mode={site.mode === 'dark' ? 'dark' : undefined}
  style={[
    `--dg-client-accent:${site.accentColor}`,
    site.onAccent && `--dg-client-on-accent:${site.onAccent}`,
    site.accentDark && `--dg-client-accent-dark:${site.accentDark}`,
    site.accentOnLight && `--dg-client-accent-on-light:${site.accentOnLight}`,
  ]
    .filter(Boolean)
    .join(';')}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.brand.name} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
        {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />}
    {site.favicon && <link rel="icon" href={site.favicon} />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />
  </head>
  <body>
    <a class="dg-skip" href="#main">Skip to content</a>
    <SiteHeader {site} {services} {areas} activePath={path} />
    <main id="main"><slot /></main>
    <SiteFooter {site} {services} {areas} />
    <script is:inline>
      const reveal = document.querySelectorAll('.dg-reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        reveal.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12 });
        reveal.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

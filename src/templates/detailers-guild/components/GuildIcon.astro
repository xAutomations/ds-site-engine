---
interface Props { name: 'arrow' | 'diagonal' | 'chevron' | 'menu' | 'close' | 'facebook' | 'instagram' | 'tiktok'; size?: number; }
const { name, size = 15 } = Astro.props;
const strokes: Record<string, string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  diagonal: 'M7 17L17 7M9 7h8v8',
  chevron: 'M6 9l6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  tiktok: 'M9 12a4 4 0 1 0 4 4V4c.5 2.5 2.5 4.5 5 5',
};
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={name === 'arrow' || name === 'diagonal' ? 2.5 : 2} aria-hidden="true">
  {name === 'instagram' ? (
    <>
      <rect x="2" y="2" width="20" height="20" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
    </>
  ) : (
    <path d={strokes[name]} />
  )}
</svg>

---
import GuildIcon from './GuildIcon.astro';
import type { GuildServiceCard } from '../types';
interface Props { heading: string; services: GuildServiceCard[]; intro?: string[]; }
const { heading, services, intro = [] } = Astro.props;
---

<section class="services dg-section dg-accent-field">
  <div class="dg-container dg-section-inner">
    <header class="head dg-reveal"><h2 class="dg-heading">{heading}</h2></header>
    {intro.length > 0 && <div class="intro dg-reveal">{intro.map((p) => <p>{p}</p>)}</div>}
    <div class="grid dg-reveal">{services.map((service) => <a class="card" href={service.href}><img class="dg-grayscale" src={service.image.src} alt={service.image.alt} loading="lazy" /><span class="shade"></span><span class="title"><strong>{service.label}</strong><i aria-hidden="true"><GuildIcon name="diagonal" /></i></span></a>)}</div>
  </div>
</section>

<style>
  .head { margin-bottom: 2.5rem; }
  .intro { display: grid; max-width: 68ch; gap: 1rem; margin: -1rem 0 2.5rem; color: color-mix(in srgb, white 88%, transparent); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .card { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--dg-accent-dark); background: var(--dg-ink); color: white; text-decoration: none; }
  .card :global(img) { height: 100%; object-fit: cover; transition: transform .45s ease; }
  .shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(32,30,29,.94), rgba(32,30,29,.12) 70%); }
  .title { position: absolute; inset: auto 0 0; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding: 1.1rem; }
  .title::after { position: absolute; inset: auto 0 0; height: 5px; background: var(--dg-accent); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .35s ease; }
  .title strong { font-size: 1.1rem; line-height: 1.15; }
  .title i { display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border: 1px solid #7d7979; font-style: normal; }
  .card:hover :global(img) { transform: scale(1.06); }
  .card:hover .title::after, .card:focus-visible .title::after { transform: scaleX(1); }
  .card:hover i { border-color: var(--dg-accent); background: var(--dg-accent); }
  @media (max-width: 64rem) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 38rem) { .grid, .intro { grid-template-columns: 1fr; } }
</style>

---
import type { InferGetStaticPropsType } from 'astro';
import { getServices } from '../../../lib/content';
import AviationEditorialService from '../pages/ServicePage.astro';

// Deliberately unannotated: adding `: GetStaticPaths` widens the return type and
// collapses InferGetStaticPropsType to `never`.
export const getStaticPaths = async () => {
  const services = await getServices();
  return services.map((entry) => ({
    params: { service: entry.data.slug },
    props: { entry },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;

---

<AviationEditorialService {entry} />

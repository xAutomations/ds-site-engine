---
import type { CollectionEntry } from 'astro:content';
import Inline from '../../../components/Inline.astro';
import { siteConfig } from '../../../lib/site-config';
import MediaSlot from '../components/MediaSlot.astro';
import SectionLabel from '../components/SectionLabel.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  entry: CollectionEntry<'quoteReceived'>;
}

const { entry } = Astro.props;
const page = entry.data;
const { contact, socials } = siteConfig;

/**
 * Social cards derive from config so the section can never advertise an account
 * the client does not have — JetSpa currently carries Instagram only, by decision.
 */
const PLATFORMS = [
  ['instagram', 'Instagram'],
  ['tiktok', 'TikTok'],
  ['youtube', 'YouTube'],
  ['facebook', 'Facebook'],
] as const;
const socialCards = PLATFORMS.flatMap(([key, label]) => {
  const url = socials[key];
  if (!url) return [];
  const segment = new URL(url).pathname.split('/').filter(Boolean).pop();
  return [{ label, url, handle: segment ? `@${segment}` : new URL(url).hostname }];
});
---

<SiteLayout title={page.title} description={page.metaDescription} path="/quote-received">
  <section class="masthead">
    <div class="masthead-copy">
      <SectionLabel>{page.masthead.eyebrow}</SectionLabel>
      <h1>{page.masthead.headline}</h1>
      <p><Inline text={page.masthead.body} /></p>
    </div>
    <aside class="status" aria-label="Request status">
      <span class="status-label"><i aria-hidden="true"></i>{page.masthead.status.label}</span>
      <strong>{page.masthead.status.headline}</strong>
      <dl>
        {
          page.masthead.status.rows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </section>

  <section class="sequence">
    <header>
      <div>
        <SectionLabel>{page.sequence.eyebrow}</SectionLabel>
        <h2>{page.sequence.heading}</h2>
      </div>
      <span>{page.sequence.note}</span>
    </header>
    <ol>
      {
        page.sequence.steps.map((step, index) => (
          <li>
            <span class="timing">
              <i aria-hidden="true" />
              {step.timing}
            </span>
            <span class="number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    {
      page.sequence.footnote && (
        <footer>
          <span>{page.sequence.footnote.left}</span>
          <span>{page.sequence.footnote.right}</span>
        </footer>
      )
    }
  </section>

  <section class="ready">
    <div class="ready-intro">
      <SectionLabel tone="light">{page.ready.eyebrow}</SectionLabel>
      <h2>{page.ready.heading}</h2>
      <p>{page.ready.intro}</p>
    </div>
    <div class="ready-items">
      {
        page.ready.items.map((item) => (
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="aog">
    <div class="aog-copy">
      <span class="status-label"><i aria-hidden="true"></i>{page.aog.statusLabel}</span>
      <h2>{page.aog.heading}</h2>
      <p><Inline text={page.aog.body} /></p>
    </div>
    <aside class="aog-call">
      <span>{page.aog.callLabel}</span>
      <a href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
      <small>{page.aog.note}</small>
    </aside>
  </section>

  <section class="wait">
    <header>
      <h2>{page.whileYouWait.heading}</h2>
      <span>{page.whileYouWait.note}</span>
    </header>
    <div class="wait-grid">
      {
        page.whileYouWait.links.map((link) => (
          <a href={link.href}>
            <span class="kind">{link.kind}</span>
            <span class="title">{link.title}</span>
            <span class="description">{link.description}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    socialCards.length > 0 && (
      <section class="connect" aria-label="Social media">
        <h2>
          {page.connect.heading} <span aria-hidden="true">·</span>{' '}
          <span class="note">{page.connect.note}</span>
        </h2>
        <div class="connect-links">
          {socialCards.map((card) => (
            <a href={card.url} target="_blank" rel="noopener noreferrer">
              <span class="platform">{card.label}</span>
              <span class="handle">{card.handle}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="cta">
    <MediaSlot {...page.cta.media} class="cta-media" sizes="55vw" />
    <div class="cta-copy">
      <SectionLabel>{page.cta.eyebrow}</SectionLabel>
      <h2>{page.cta.heading}</h2>
      <p>{page.cta.body}</p>
      <div class="actions">
        <a class="ae-button ae-button--primary" href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a>
        <a class="ae-button" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
      <div class="also-useful">
        <span>{page.cta.alsoUsefulLabel}</span>
        <nav>
          {
            page.cta.alsoUseful.map((link) => (
              <a href={link.href}>
                <span>{link.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* Shared mono status line ("● Status", "● AOG dispatch — …"). */
  .status-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .status-label i {
    width: 0.38rem;
    height: 0.38rem;
    flex: none;
    border-radius: 50%;
    background: var(--ae-accent);
  }

  .masthead {
    display: grid;
    padding: 5.5rem var(--ae-gutter) 4rem;
    border-bottom: 1px solid var(--ae-line);
    grid-template-columns: minmax(0, 1fr) 26.25rem;
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: center;
  }

  h1 {
    max-width: 47.5rem;
    margin-top: 1.65rem;
    font-size: clamp(3rem, 5vw, 3.75rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.02;
    text-wrap: pretty;
  }

  .masthead-copy > p {
    max-width: 41.25rem;
    margin-top: 1.75rem;
    color: var(--ae-copy);
    font-size: 1.18rem;
    line-height: 1.55;
  }

  .status {
    display: flex;
    padding: 0.25rem 0 0.25rem 1.75rem;
    border-left: 2px solid var(--ae-accent);
    flex-direction: column;
    gap: 0.85rem;
  }

  .status strong {
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.016em;
    line-height: 1.25;
  }

  .status dl {
    display: flex;
    margin: 0.25rem 0 0;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--ae-mono);
    font-size: 0.78rem;
  }

  .status dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--ae-line-soft);
  }

  .status dl div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .status dt {
    color: var(--ae-muted);
  }

  .status dd {
    margin: 0;
    color: var(--ae-bone);
    text-align: right;
  }

  .sequence {
    padding: 5.5rem var(--ae-gutter) 5.75rem;
    border-bottom: 1px solid var(--ae-line);
    background: var(--ae-deck);
  }

  .sequence header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .sequence h2,
  .ready h2,
  .aog h2 {
    margin-top: 1.35rem;
    font-size: clamp(2.1rem, 3.2vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.024em;
    line-height: 1.12;
  }

  .sequence header > span,
  .wait header span {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .sequence ol {
    position: relative;
    display: grid;
    margin: 3.25rem 0 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(3, 1fr);
  }

  /* The horizontal rail the timing markers sit on. */
  .sequence ol::before {
    position: absolute;
    top: 0.55rem;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--ae-line);
    content: '';
  }

  .sequence li {
    position: relative;
    padding-right: 2.75rem;
  }

  .sequence li + li {
    padding-left: 2.75rem;
    border-left: 1px solid var(--ae-line-soft);
  }

  .sequence li:last-child {
    padding-right: 0;
  }

  .timing {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    padding-right: 0.6rem;
    background: var(--ae-deck);
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    line-height: 1.2rem;
    text-transform: uppercase;
  }

  .timing i {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    background: var(--ae-accent);
    transform: rotate(45deg);
  }

  .sequence .number {
    display: block;
    margin-top: 2rem;
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 3.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .sequence h3 {
    margin-top: 1.25rem;
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .sequence li p {
    margin-top: 1rem;
    color: var(--ae-copy);
    font-size: 1rem;
    line-height: 1.7;
  }

  .sequence footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ae-line);
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sequence footer span:last-child {
    color: var(--ae-copy);
  }

  .ready {
    display: grid;
    padding: 6rem var(--ae-gutter) 5.75rem;
    background: var(--ae-bone);
    color: var(--ae-paper-ink);
    grid-template-columns: minmax(16rem, 23.75rem) minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: start;
  }

  .ready-intro > p {
    max-width: 20rem;
    margin-top: 1.25rem;
    color: var(--ae-paper-copy);
    line-height: 1.7;
  }

  .ready-items > div {
    display: grid;
    padding: 1.9rem 0;
    border-bottom: 1px solid rgba(21, 23, 26, 0.16);
    grid-template-columns: 17.5rem 1fr;
    gap: 2.5rem;
  }

  .ready-items > div:first-child {
    border-top: 1px solid rgba(21, 23, 26, 0.16);
  }

  .ready-items h3 {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.014em;
  }

  .ready-items p {
    max-width: 40rem;
    color: var(--ae-paper-copy);
    line-height: 1.7;
  }

  .aog {
    display: grid;
    padding: 4.75rem var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line);
    background: var(--ae-deck);
    grid-template-columns: minmax(0, 1fr) 28.75rem;
    gap: clamp(3rem, 6vw, 4.5rem);
    align-items: center;
  }

  .aog-copy > p {
    max-width: 40rem;
    margin-top: 1.1rem;
    color: var(--ae-copy);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .aog-copy p :global(a) {
    color: var(--ae-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--ae-accent) 55%, transparent);
  }

  .aog-copy p :global(a:hover) {
    color: #d6b482;
  }

  .aog-call {
    display: flex;
    padding: 0.35rem 0 0.35rem 1.85rem;
    border-left: 2px solid var(--ae-accent);
    flex-direction: column;
    gap: 0.75rem;
  }

  .aog-call > span,
  .aog-call small {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .aog-call small {
    letter-spacing: 0.14em;
  }

  .aog-call a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.4rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--ae-accent) 50%, transparent);
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .aog-call a:hover {
    border-color: color-mix(in srgb, var(--ae-accent) 80%, transparent);
    color: #d6b482;
  }

  .wait {
    padding: 5rem var(--ae-gutter) 4.75rem;
    border-bottom: 1px solid var(--ae-line);
  }

  .wait header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--ae-line);
  }

  .wait h2 {
    font-size: 1.85rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .wait-grid {
    display: grid;
    margin-top: 1.65rem;
    border: 1px solid var(--ae-line);
    background: var(--ae-line);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1px;
  }

  .wait-grid a {
    display: flex;
    padding: 2.1rem 2rem;
    background: var(--ae-ink);
    flex-direction: column;
    gap: 0.75rem;
  }

  .wait-grid a:hover,
  .wait-grid a:focus-visible {
    background: var(--ae-panel);
  }

  .wait-grid .kind {
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .wait-grid .title {
    color: var(--ae-bone);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.018em;
  }

  .wait-grid .description {
    color: var(--ae-muted);
    line-height: 1.65;
  }

  /* Slim utility band, echoing the "On station" strip in the site chrome. */
  .connect {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.85rem 2rem;
    padding: 1rem var(--ae-gutter);
    border-bottom: 1px solid var(--ae-line);
    background: var(--ae-deck);
  }

  .connect h2 {
    color: var(--ae-copy);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .connect h2 .note {
    color: var(--ae-muted);
  }

  .connect-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .connect-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--ae-accent) 50%, transparent);
    font-family: var(--ae-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .connect-links a:hover,
  .connect-links a:focus-visible {
    border-color: color-mix(in srgb, var(--ae-accent) 80%, transparent);
  }

  .connect-links .platform {
    color: var(--ae-muted);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .connect-links .handle,
  .connect-links .arrow {
    color: var(--ae-accent);
  }

  .connect-links a:hover .handle,
  .connect-links a:hover .arrow {
    color: #d6b482;
  }

  .cta {
    display: grid;
    border-top: 1px solid var(--ae-line);
    grid-template-columns: minmax(0, 1fr) minmax(30rem, calc(38.75rem + var(--ae-slack)));
  }

  .cta :global(.cta-media) {
    min-height: 23.75rem;
    height: 100%;
    border: 0;
  }

  .cta-copy {
    display: flex;
    padding: 4.5rem calc(var(--ae-gutter-base) + var(--ae-slack) / 2) 4.25rem;
    border-left: 1px solid var(--ae-line);
    flex-direction: column;
  }

  .cta-copy h2 {
    margin-top: 1.5rem;
    font-size: clamp(2.2rem, 3.2vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.026em;
    line-height: 1.08;
  }

  .cta-copy > p {
    max-width: 29.5rem;
    margin-top: 1.1rem;
    color: var(--ae-muted);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  /* The email address is long; let the button shrink rather than overflow. */
  .actions .ae-button {
    max-width: 100%;
    text-transform: none;
    letter-spacing: 0.08em;
  }

  .also-useful {
    margin-top: auto;
    padding-top: 2.5rem;
  }

  .also-useful > span {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .also-useful nav {
    margin-top: 0.75rem;
  }

  .also-useful nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.9rem;
    border-bottom: 1px solid var(--ae-line-soft);
    color: var(--ae-copy);
    font-size: 0.95rem;
  }

  .also-useful nav a:last-child {
    border-bottom: 0;
  }

  .also-useful nav a:hover {
    color: #fff;
  }

  .also-useful nav a span:last-child {
    color: var(--ae-accent);
  }

  @media (max-width: 62rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: 2.5rem;
    }

    .aog {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: 2.5rem;
    }

    .ready {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: 2.5rem;
    }

    .ready-items > div {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }

    .cta {
      grid-template-columns: 1fr 28rem;
    }
  }

  @media (max-width: 47.99rem) {
    .masthead {
      display: block;
      padding: 1.75rem var(--ae-gutter) 1.65rem;
    }

    h1 {
      margin-top: 0.9rem;
      font-size: 2rem;
      line-height: 1.04;
    }

    .masthead-copy > p {
      margin-top: 0.9rem;
      font-size: 0.96rem;
      line-height: 1.6;
    }

    .status {
      margin-top: 1.5rem;
      padding-left: 1.15rem;
      gap: 0.55rem;
    }

    .status strong {
      font-size: 1.05rem;
    }

    .sequence {
      padding: 1.9rem var(--ae-gutter) 2rem;
    }

    .sequence header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .sequence h2,
    .ready h2,
    .aog h2 {
      margin-top: 0.85rem;
      font-size: 1.5rem;
    }

    .sequence header > span {
      display: none;
    }

    .sequence ol {
      display: block;
      margin-top: 1.5rem;
    }

    .sequence ol::before {
      display: none;
    }

    .sequence li {
      padding: 1.15rem 0 1.25rem;
      border-top: 1px solid var(--ae-line-soft);
    }

    .sequence li + li {
      padding-left: 0;
      border-left: 0;
    }

    .sequence .number {
      display: none;
    }

    .sequence h3 {
      margin-top: 0.75rem;
      font-size: 1.15rem;
    }

    .sequence li p {
      margin-top: 0.5rem;
      font-size: 0.88rem;
    }

    .sequence footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .ready {
      display: block;
      padding: 1.9rem var(--ae-gutter) 1.75rem;
    }

    .ready-intro > p {
      font-size: 0.88rem;
    }

    .ready-items {
      margin-top: 1.35rem;
    }

    .ready-items > div {
      display: block;
      padding: 1rem 0 1.15rem;
    }

    .ready-items h3 {
      font-size: 1.05rem;
    }

    .ready-items p {
      margin-top: 0.45rem;
      font-size: 0.88rem;
    }

    .aog {
      display: block;
      padding: 1.9rem var(--ae-gutter) 1.75rem;
    }

    .aog-copy > p {
      font-size: 0.92rem;
    }

    .aog-call {
      margin-top: 1.4rem;
      padding-left: 1.15rem;
    }

    .wait {
      padding: 1.9rem var(--ae-gutter) 1.75rem;
    }

    .wait header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
      padding-bottom: 0.75rem;
    }

    .wait h2 {
      font-size: 1.35rem;

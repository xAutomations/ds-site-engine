---
import Img from '../../../components/Img.astro';
import { getBlogPosts } from '../../../lib/content';
import { siteConfig } from '../../../lib/site-config';
import SiteLayout from '../layouts/SiteLayout.astro';

const posts = await getBlogPosts();
const { brand } = siteConfig;
---

<SiteLayout
  title={`Blog | ${brand.name}`}
  description={`Read the latest from ${brand.name} — aircraft detailing insights, tips, and service guides.`}
  path="/blog"
>
  <section class="blog-masthead">
    <h1>Blog</h1>
    <p>{brand.name} aircraft detailing insights, tips, and service guides.</p>
  </section>

  <section class="blog-grid">
    {posts.length === 0 && <p class="empty">No posts yet.</p>}
    {
      posts.map((post) => (
        <a class="blog-card" href={`/post/${post.data.slug}`}>
          <div class="card-image">
            <Img src={post.data.heroImage.src} alt={post.data.heroImage.alt} widths={[600]} sizes="600px" />
          </div>
          <div class="card-body">
            <time datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.metaDescription}</p>
            <span class="card-category">{post.data.category}</span>
          </div>
        </a>
      ))
    }
  </section>
</SiteLayout>

<style>
  .blog-masthead {
    padding: 5.5rem var(--ae-gutter) 3rem;
    border-bottom: 1px solid var(--ae-line);
  }

  .blog-masthead h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.02;
  }

  .blog-masthead p {
    max-width: 32rem;
    margin-top: 0.75rem;
    color: var(--ae-copy);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .blog-grid {
    display: grid;
    padding: 3rem var(--ae-gutter) 5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 2rem;
  }

  .blog-card {
    display: flex;
    border: 1px solid var(--ae-line);
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease;
  }

  .blog-card:hover {
    border-color: var(--ae-accent);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ae-panel);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex: 1;
    padding: 1.25rem 1.35rem 1.5rem;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-body time {
    color: var(--ae-muted);
    font-family: var(--ae-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card-body h2 {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .card-body > p {
    color: var(--ae-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .card-category {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.25rem 0.6rem;
    background: var(--ae-deck);
    color: var(--ae-accent);
    font-family: var(--ae-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .empty {
    grid-column: 1 / -1;
    color: var(--ae-muted);
    text-align: center;
    padding: 4rem 0;
  }

  @media (max-width: 47.99rem) {
    .blog-masthead { padding: 2rem var(--ae-gutter) 1.5rem; }
    .blog-grid { padding: 1.5rem var(--ae-gutter) 3rem; gap: 1.25rem; }
  }
</style>
